(in-package #:cl-stack-pathlib/tests)

;;; R4c-0: copy-on-write clones. The laws through the clone suite (:COPY and
;;; the fakes; the suite catching a data-sharing and a lossy mechanism), the
;;; registry, FS-CLONE-SUPPORTED-P, FS-CLONE-TREE / FS-CLONE-FILE
;;; (mechanism choice, reports, the tree hook, per-file fallbacks, CLONE-ERROR
;;; and USE-COPY, destinations, metadata), FS-SET-MTIME, and areas built by
;;; clones.

(defun failures-of (kind failures)
  (remove kind failures :key (lambda (f) (getf f :kind)) :test-not #'eq))

(defun steps-of (failures)
  (remove-duplicates (mapcar (lambda (f) (getf f :step)) failures)))

;;; --- the laws ----------------------------------------------------------------------

(deftest-parametrize clone-law-copy
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (multiple-value-bind (failures steps) (run-clone-suite :copy :backend kind)
    (ok (null failures) (format nil "the copy rung keeps every law: ~S" failures))
    (ok (equal (clone-suite-steps :backend kind) steps) "every applicable step ran")
    (ok (member :equivalence steps))
    (ok (member :independence steps))
    (ok (not (member :cross-volume steps)) ":copy has no cross-volume step")
    (ok (eq (eq kind :local) (and (member :sparse steps) t)) "sparse files on local only")))

(deftest-parametrize clone-law-fakes
    ((mechanism kind)
     :ids ("clone/local" "clone/memory" "tree/local" "tree/memory"
           "decline/local" "decline/memory" "partial/local" "partial/memory")
     (:fake-clone :local) (:fake-clone :memory)
     (:fake-tree :local) (:fake-tree :memory)
     (:fake-decline :local) (:fake-decline :memory)
     (:fake-partial :local) (:fake-partial :memory))
  (with-clone-fakes (:fake-tree :fake-decline :fake-partial)
    (multiple-value-bind (failures steps) (run-clone-suite mechanism :backend kind)
      (ok (null failures) (format nil "~S keeps every law: ~S" mechanism failures))
      (ok (equal (clone-suite-steps :backend kind :mechanism mechanism) steps)))))

(deftest clone-law-cross-volume
  ;; The fake treats any destination under ".../other-volume/" as another volume.
  (with-backend (work :local)
    (let ((other (subdir work "other-volume")))
      (mkdir other :parents t)
      (with-clone-fakes (:fake-cross-volume)
        (multiple-value-bind (failures steps)
            (run-clone-suite :fake-cross-volume :other-volume other)
          (ok (null failures) (format nil "fallback reported: ~S" failures))
          (ok (member :cross-volume steps))
          (ok (equal (clone-suite-steps :mechanism :fake-cross-volume :other-volume other) steps)))))))

(deftest clone-suite-catches-shared-data
  (if (not (and (unix-modes-p) (local-mtimes-p)))
      (skip "hard links need SBCL on unix")
      (with-clone-fakes (:fake-shared)
        (let* ((failures (run-clone-suite :fake-shared))
               (independence (failures-of :independence failures)))
          (ok independence "a mechanism that shares data with its source breaks independence")
          (ok (member :independence (steps-of independence)) "found by the clone-side writes")
          (ok (member :independence-reverse (steps-of independence)) "and by the source-side writes")
          (ok (null (failures-of :content (remove :independence failures
                                                  :key (lambda (f) (getf f :step)) :test-not #'eq)))
              "the content law alone cannot tell")))))

(deftest-parametrize clone-suite-catches-lossy-metadata
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (if (and (eq kind :local) (not (local-mtimes-p)))
      (skip "local mtimes are only set on SBCL unix")
      (with-clone-fakes (:fake-lossy)
        (let* ((failures (run-clone-suite :fake-lossy :backend kind))
               (metadata (failures-of :metadata failures)))
          (ok metadata "lost mtimes are a metadata failure")
          (ok (find :tree metadata :key (lambda (f) (getf f :step))))
          (ok (find :mtime metadata :key (lambda (f) (getf f :check))))
          (when (and (eq kind :local) (unix-modes-p))
            (ok (find :mode metadata :key (lambda (f) (getf f :check))) "lost modes too"))))))

(deftest-parametrize clone-suite-reports-unavailable
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-clone-fakes (:fake-unsupported)
    (let ((failures (run-clone-suite :fake-unsupported :backend kind)))
      (ok (find :supported (failures-of :mechanism failures) :key (lambda (f) (getf f :step)))
          "an unavailable mechanism fails the :supported step")
      (ok (find :tree (failures-of :error failures) :key (lambda (f) (getf f :step)))
          "and the tree step cannot clone (unsupported-operation)"))))

(deftest clone-suite-unknown-mechanism
  (let ((failures (run-clone-suite :no-such-clone-mechanism :backend :memory)))
    (ok failures)
    (ok (find :supported (failures-of :mechanism failures) :key (lambda (f) (getf f :step))))))

;;; --- the registry --------------------------------------------------------------------

(deftest clone-registry-order-and-scope
  (ok (null *clone-mechanisms*) "nothing registered outside the fakes")
  (with-clone-fakes ()
    (ok (equal '(:copy) (clone-mechanisms)) ":copy alone")
    (ok (eq :fake-a (register-clone-mechanism :fake-a 'fake-copy-file)) "returns the name")
    (register-clone-mechanism :fake-b 'fake-copy-file :rank 5)
    (register-clone-mechanism :fake-c 'fake-copy-file :rank 5)
    (register-clone-mechanism :fake-d 'fake-copy-file :rank -1)
    (ok (equal '(:fake-b :fake-c :fake-a :fake-d :copy) (clone-mechanisms))
        "rank, highest first; ties in registration order; :copy last")
    (register-clone-mechanism :fake-c 'fake-copy-file :rank 9)
    (ok (equal '(:fake-c :fake-b :fake-a :fake-d :copy) (clone-mechanisms)) "replaced in place, new rank")
    (ok (eq t (unregister-clone-mechanism :fake-b)))
    (ok (null (unregister-clone-mechanism :fake-b)) "second unregister → NIL")
    (ok (equal '(:fake-c :fake-a :fake-d :copy) (clone-mechanisms))))
  (ok (null *clone-mechanisms*) "the LET scoped every registration"))

(deftest clone-registry-does-not-modify-old-list
  (with-clone-fakes (:fake-clone)
    (let ((old *clone-mechanisms*))
      (let ((*clone-mechanisms* *clone-mechanisms*))
        (register-clone-mechanism :fake-x 'fake-copy-file :rank 100)
        (unregister-clone-mechanism :fake-clone))
      (ok (eq old *clone-mechanisms*))
      (ok (equal '(:fake-clone :copy) (clone-mechanisms))))))

(deftest clone-registry-refusals
  (with-clone-fakes ()
    (dolist (reserved '(:copy :auto :clone))
      (ok (signals (register-clone-mechanism reserved 'fake-copy-file) 'error)
          (format nil "~S is reserved" reserved)))
    (ok (signals (register-clone-mechanism "fake" 'fake-copy-file) 'type-error))
    (ok (signals (register-clone-mechanism :fake-r 'fake-copy-file :rank 1.5) 'type-error))
    (ok (signals (register-clone-mechanism :fake-r 42) 'type-error))
    (ok (equal '(:copy) (clone-mechanisms)) "nothing registered by a refusal")))

(deftest-parametrize clone-registry-availability
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let* ((fs (path-filesystem work)) (dir (path-pathname work)))
      (with-clone-fakes ()
        (ok (equal '(nil :no-mechanism) (multiple-value-list (fs-clone-supported-p fs dir)))
            "nothing registered")
        (ok (equal '(:copy) (clone-mechanisms fs dir dir))))
      (with-clone-fakes (:fake-unsupported)
        (ok (equal '(nil :unsupported-volume) (multiple-value-list (fs-clone-supported-p fs dir))))
        (ok (equal '(:copy) (clone-mechanisms fs dir dir)))
        (ok (equal '(:fake-unsupported :copy) (clone-mechanisms)) "listed without FS"))
      (with-clone-fakes (:fake-unavailable)
        (ok (equal '(nil :unavailable) (multiple-value-list (fs-clone-supported-p fs dir)))
            "NIL without a reason → :unavailable"))
      (with-clone-fakes (:fake-unavailable :fake-unsupported)
        (ok (equal '(nil :unsupported-volume) (multiple-value-list (fs-clone-supported-p fs dir)))
            "the best-ranked mechanism's reason"))
      (with-clone-fakes (:fake-local-only)
        (ok (equal (if (eq kind :local) '(:fake-local-only nil) '(nil :unsupported-filesystem))
                   (multiple-value-list (fs-clone-supported-p fs dir)))))
      (with-clone-fakes (:fake-unsupported :fake-clone)
        (ok (equal '(:fake-clone nil) (multiple-value-list (fs-clone-supported-p fs dir)))
            "an unavailable mechanism is skipped")
        (ok (equal '(:fake-clone :copy) (clone-mechanisms fs dir dir))))
      (with-clone-fakes (:fake-clone)
        (ok (equal '(:fake-clone nil) (multiple-value-list (clone-supported-p work))) "facade")))))

(deftest-parametrize clone-registry-probe-arguments
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((fs (path-filesystem work))
          (src (subdir work "src"))
          (deep (subdir work "dst/not/yet")))
      (mkdir src :parents t)
      (with-clone-fakes (:fake-recorder)
        (fs-clone-supported-p fs (path-pathname src))
        (fs-clone-supported-p fs (path-pathname src) (path-pathname deep))
        (let ((calls (fake-log-of :available-p :fake-recorder)))
          (ok (= 2 (length calls)))
          (ok (same-directory-p src (third (first calls))) "the source directory")
          (ok (same-directory-p src (fourth (first calls))) "destination defaults to the directory")
          (ok (same-directory-p work (fourth (second calls)))
              "a missing destination is judged by its nearest existing ancestor"))))))

;;; --- fs-clone-tree: mechanism choice and reports -------------------------------------------

(deftest-parametrize clone-tree-auto
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes ()
        (let ((r (clone-tree base (subdir work "d1") :ignore :auto)))
          (ok (clone-report-p r))
          (ok (eq :copy (clone-report-mechanism r)))
          (ok (eq :no-mechanism (clone-report-reason r)) "why it copied")
          (ok (= 0 (clone-report-cloned r)))
          (ok (= (length +clone-auto-files+) (clone-report-copied r)))
          (ok (null (clone-report-fallbacks r)))
          (ok (same-directory-p base (clone-report-source r)))
          (ok (same-directory-p (subdir work "d1") (clone-report-destination r)))
          (ok (equal +clone-auto-files+ (walk-files (subdir work "d1"))))))
      (with-clone-fakes (:fake-unsupported :fake-clone)
        (let ((r (clone-tree base (subdir work "d2") :ignore :auto)))
          (ok (eq :fake-clone (clone-report-mechanism r)) "the best available one")
          (ok (null (clone-report-reason r)))
          (ok (= (length +clone-auto-files+) (clone-report-cloned r)))
          (ok (= 0 (clone-report-copied r)))
          (ok (= (length +clone-auto-files+) (length (fake-log-of :clone-file :fake-clone)))
              "one CLONE-FILE call per regular file")))
      (with-clone-fakes (:fake-unsupported)
        (let ((r (clone-tree base (subdir work "d3") :ignore :auto)))
          (ok (eq :copy (clone-report-mechanism r)))
          (ok (eq :unsupported-volume (clone-report-reason r)))))
      (ok (equal (tree-id base :auto) (tree-id (subdir work "d1")))))))

(deftest-parametrize clone-tree-explicit-mechanisms
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes (:fake-clone :fake-unsupported)
        (let ((r (clone-tree base (subdir work "c1") :mechanism :copy)))
          (ok (eq :copy (clone-report-mechanism r)))
          (ok (null (clone-report-reason r)) ":copy asked for: no reason")
          (ok (= 0 (clone-report-cloned r)))
          (ok (null (fake-log-of :clone-file)) "no mechanism called"))
        (let ((r (clone-tree base (subdir work "c2") :mechanism :clone)))
          (ok (eq :fake-clone (clone-report-mechanism r)) ":clone = the best available clone"))
        (let ((r (clone-tree base (subdir work "c3") :mechanism :fake-clone)))
          (ok (eq :fake-clone (clone-report-mechanism r))))
        (ok (signals (clone-tree base (subdir work "c4") :mechanism :fake-unsupported)
                     'unsupported-operation)
            "a named mechanism that is unavailable")
        (ok (not (exists-p (subdir work "c4"))) "nothing created")
        (ok (signals (clone-tree base (subdir work "c5") :mechanism :no-such) 'unsupported-operation))
        (ok (not (exists-p (subdir work "c5")))))
      (with-clone-fakes (:fake-unsupported)
        (ok (signals (clone-tree base (subdir work "c6") :mechanism :clone) 'unsupported-operation)
            ":clone with no clone available")
        (ok (not (exists-p (subdir work "c6"))))))))

(deftest-parametrize clone-tree-hook
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes (:fake-tree :fake-decline)
        (let ((r (clone-tree base (subdir work "t1") :ignore :auto :mechanism :fake-tree)))
          (ok (eq :fake-tree (clone-report-mechanism r)))
          (ok (= (length +clone-auto-files+) (clone-report-cloned r)) "the hook's count")
          (let ((calls (fake-log-of :clone-tree :fake-tree)))
            (ok (= 1 (length calls)) "called once for the tree")
            (ok (same-directory-p base (third (first calls))))
            (ok (same-directory-p (subdir work "t1") (fourth (first calls))))
            (ok (ignore-matcher-p (fifth (first calls))) ":auto is resolved before the hook"))
          (ok (null (fake-log-of :clone-file :fake-tree)) "no per-file calls of its own")
          (ok (equal (tree-id base :auto) (tree-id (subdir work "t1")))))
        (let ((r (clone-tree base (subdir work "t2") :mechanism :fake-decline)))
          (ok (= 1 (length (fake-log-of :clone-tree :fake-decline))))
          (ok (null (fifth (first (fake-log-of :clone-tree :fake-decline)))) "no ignore → NIL matcher")
          (ok (eq :fake-decline (clone-report-mechanism r)))
          (ok (= (length (walk-files (subdir work "t2"))) (clone-report-cloned r)))
          (ok (= (clone-report-cloned r) (length (fake-log-of :clone-file :fake-decline)))
              "declined: one CLONE-FILE call per file")
          (ok (equal (tree-id base) (tree-id (subdir work "t2")))))))))

(deftest-parametrize clone-tree-per-file-fallback
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (make-tree base `(("deep/huge.bin" ,(make-array (* 3 1024 1024) :element-type '(unsigned-byte 8)
                                                                       :initial-element 9))))
      (with-clone-fakes (:fake-partial)
        (let ((r (clone-tree base (subdir work "p") :ignore :auto :mechanism :fake-partial)))
          (ok (eq :fake-partial (clone-report-mechanism r)))
          (ok (null (clone-report-reason r)))
          (ok (equal '(("big.bin" . :clone-failed) ("deep/huge.bin" . :clone-failed))
                     (clone-report-fallbacks r))
              "sorted (path . reason)")
          (ok (= 2 (clone-report-copied r)))
          (ok (= (1- (length +clone-auto-files+)) (clone-report-cloned r))
              "the other regular files (big.bin is one of +clone-auto-files+)")
          (ok (equal (tree-id base :auto) (tree-id (subdir work "p"))) "the tree is still whole"))))))

(deftest-parametrize clone-tree-clone-error
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes (:fake-signal)
        ;; Unhandled: the condition escapes and the destination is as before.
        (let ((c (handler-case (progn (clone-tree base (subdir work "s1") :mechanism :fake-signal) nil)
                   (clone-error (e) e))))
          (ok (typep c 'clone-error))
          (ok (typep c 'path-error) "a path-error")
          (ok (eq :fake-signal (clone-error-mechanism c)))
          (ok (equal "fake-clone" (clone-error-operation c)))
          (ok (eql 5 (clone-error-code c)))
          (ok (string= "a.txt" (name (ensure-path (path-error-path c))))))
        (ok (not (exists-p (subdir work "s1"))) "an absent destination is removed")
        (let ((empty (subdir work "s2")))
          (mkdir empty :parents t)
          (ok (signals (clone-tree base empty :mechanism :fake-signal) 'clone-error))
          (ok (and (directory-p empty) (null (iterdir empty))) "an empty destination is emptied"))
        ;; USE-COPY: offered around the call; the file is copied instead.
        (let ((offered nil))
          (let ((r (handler-bind ((clone-error (lambda (c)
                                                 (setf offered (and (find-restart 'use-copy c) t))
                                                 (invoke-use-copy c))))
                     (clone-tree base (subdir work "s3") :mechanism :fake-signal))))
            (ok offered "USE-COPY is offered")
            (ok (equal '(("a.txt" . :clone-failed)) (clone-report-fallbacks r)))
            (ok (= 1 (clone-report-copied r)))
            (ok (equal (tree-id base) (tree-id (subdir work "s3"))))))))))

(deftest-parametrize clone-tree-destinations
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes ()
        (clone-tree base (subdir work "a/b/c"))
        (ok (equal (tree-id base) (tree-id (subdir work "a/b/c"))) "absent: made with its parents")
        (mkdir (subdir work "empty-dst") :parents t)
        (clone-tree base (subdir work "empty-dst"))
        (ok (equal (tree-id base) (tree-id (subdir work "empty-dst"))) "an empty directory is used")
        (make-tree (subdir work "busy") '(("x" "x")))
        (ok (signals (clone-tree base (subdir work "busy")) 'path-exists-error))
        (ok (equal '("x") (walk-files (subdir work "busy"))) "left untouched")
        (ok (signals (clone-tree base (subdir base "inside")) 'path-error))
        (ok (not (exists-p (subdir base "inside"))))
        (ok (signals (clone-tree (subdir work "missing") (subdir work "m")) 'path-not-found))
        (ok (not (exists-p (subdir work "m"))))
        (ok (signals (clone-tree (join base "a.txt") (subdir work "f")) 'path-error))
        (ok (not (exists-p (subdir work "f"))))))))

(deftest-parametrize clone-tree-ignore
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes ()
        (clone-tree base (subdir work "i1") :ignore :auto)
        (ok (equal +clone-auto-files+ (walk-files (subdir work "i1"))) ":auto: ignored and .git left out")
        (ok (directory-p (subdir work "i1/empty")) "empty directories kept")
        (ok (not (exists-p (subdir work "i1/build"))) "ignored directories not made")
        (clone-tree base (subdir work "i2"))
        (ok (equal (walk-files base) (walk-files (subdir work "i2"))) "no ignore: everything")
        (clone-tree base (subdir work "i3") :ignore (parse-ignore (list "src/" "*.bin")))
        (ok (equal '(".git/HEAD" ".gitignore" "a.txt" "b.txt" "build/out.o" "run.sh" "x.log")
                   (walk-files (subdir work "i3")))
            "an explicit matcher")))))

(deftest clone-tree-local-metadata
  (with-backend (work :local)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes ()
        (when (unix-modes-p)
          (chmod (join base "run.sh") #o755)
          (chmod (join base "b.txt") #o600))
        (when (local-mtimes-p)
          (ok (eq t (set-mtime (join base "a.txt") +old-time+))))
        (unless (uiop:os-windows-p)
          (create-symlink (join base "lnk-dir") "src")
          (create-symlink (join base "src/up") "../a.txt"))
        #+(and sbcl unix)
        (sb-posix:mkfifo (native (join base "fifo")) #o644)
        (dolist (mechanism '(:copy :auto))
          (let ((dst (subdir work (format nil "m-~(~A~)" mechanism))))
            (clone-tree base dst :mechanism mechanism)
            (when (unix-modes-p)
              (ok (= #o755 (logand #o777 (file-stat-mode (stat (join dst "run.sh"))))))
              (ok (= #o600 (logand #o777 (file-stat-mode (stat (join dst "b.txt")))))
                  "all permission bits, not only the execute bit"))
            (when (local-mtimes-p)
              (ok (= +old-time+ (file-stat-mtime (stat (join dst "a.txt")))) "mtime kept"))
            (unless (uiop:os-windows-p)
              (ok (symlink-p (join dst "lnk-dir")) "a directory link stays a link")
              (ok (equal "../a.txt" (as-posix (read-symlink (join dst "src/up")))) "target as written"))
            #+(and sbcl unix)
            (ok (not (or (exists-p (join dst "fifo")) (symlink-p (join dst "fifo"))))
                "a FIFO is left out")
            (ok (equal (tree-id base) (tree-id dst)))))))))

(deftest clone-tree-memory-mtime
  (with-backend (work :memory)
    (let ((base (subdir work "base")))
      (clone-base base)
      (ok (eq t (set-mtime (join base "a.txt") +old-time+)))
      (clone-tree base (subdir work "d"))
      (ok (= +old-time+ (file-stat-mtime (stat (join (subdir work "d") "a.txt")))))
      (ok (null (file-stat-mode (stat (join (subdir work "d") "a.txt")))) "memory has no modes"))))

;;; --- fs-clone-file -------------------------------------------------------------------------

(deftest-parametrize clone-file-basics
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes (:fake-clone)
        (let ((r (clone-file (join base "a.txt") (join work "out/deep/a.txt"))))
          (ok (eq :fake-clone (clone-report-mechanism r)))
          (ok (= 1 (clone-report-cloned r)))
          (ok (= 0 (clone-report-copied r)))
          (ok (equal "aaa" (read-text (join work "out/deep/a.txt"))) "parents made"))
        (let ((r (clone-file (join base "b.txt") (join work "b.txt") :mechanism :copy)))
          (ok (eq :copy (clone-report-mechanism r)))
          (ok (= 1 (clone-report-copied r)))
          (ok (= 1 (length (fake-log-of :clone-file))) "only the first call cloned"))
        ;; Existing destination.
        (make-tree work '(("x.txt" "old")))
        (let ((c (handler-case (progn (clone-file (join base "a.txt") (join work "x.txt")) nil)
                   (path-exists-error (e) e))))
          (ok c "path-exists-error without :replace")
          (ok (equal "old" (read-text (join work "x.txt")))))
        (let ((offered nil))
          (handler-bind ((path-exists-error (lambda (c)
                                              (setf offered (and (find-restart 'overwrite c) t))
                                              (invoke-overwrite c))))
            (clone-file (join base "a.txt") (join work "x.txt")))
          (ok offered "OVERWRITE is offered")
          (ok (equal "aaa" (read-text (join work "x.txt")))))
        (make-tree work '(("y.txt" "old")))
        (clone-file (join base "b.txt") (join work "y.txt") :replace t)
        (ok (equal "bbb" (read-text (join work "y.txt"))))
        (ok (equal '("b.txt" "base" "out" "x.txt" "y.txt") (list-names work)) "no temp file left")
        ;; Refusals.
        (ok (signals (clone-file (join base "src") (join work "s")) 'path-error) "a directory source")
        (ok (signals (clone-file (join base "nope") (join work "n")) 'path-not-found))
        (ok (not (exists-p (join work "n"))))
        (ok (signals (clone-file (join base "a.txt") (subdir work "out")) 'path-error)
            "a directory destination")
        (ok (signals (clone-file (join base "a.txt") (join work "z") :mechanism :no-such)
                     'unsupported-operation))
        (ok (not (exists-p (join work "z"))))))))

(deftest-parametrize clone-file-symlink
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (if (and (eq kind :local) (uiop:os-windows-p))
      (skip "local symlinks are not tested on Windows")
      (with-backend (work kind)
        (let ((base (subdir work "base")))
          (clone-base base)
          (create-symlink (join base "link") "a.txt")
          (with-clone-fakes (:fake-clone)
            (clone-file (join base "link") (join work "link-copy"))
            (ok (symlink-p (join work "link-copy")))
            (ok (equal (as-posix (read-symlink (join base "link")))
                       (as-posix (read-symlink (join work "link-copy")))))
            (ok (null (fake-log-of :clone-file)) "links are made by pathlib, not the mechanism"))))))

(deftest-parametrize clone-file-fallbacks
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (clone-base base)
      (with-clone-fakes (:fake-partial)
        (let ((r (clone-file (join base "big.bin") (join work "big.bin") :mechanism :fake-partial)))
          (ok (eq :fake-partial (clone-report-mechanism r)))
          (ok (= 0 (clone-report-cloned r)))
          (ok (= 1 (clone-report-copied r)))
          (ok (equal '(("big.bin" . :clone-failed)) (clone-report-fallbacks r))
              "a single file: the path is its name")
          (ok (equal (content-hash (join base "big.bin")) (content-hash (join work "big.bin"))))))
      (with-clone-fakes (:fake-unsupported)
        (let ((r (clone-file (join base "a.txt") (join work "a.txt"))))
          (ok (eq :copy (clone-report-mechanism r)))
          (ok (eq :unsupported-volume (clone-report-reason r))))))))

;;; --- fs-set-mtime ------------------------------------------------------------------------

(deftest-parametrize set-mtime-backends
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (make-tree work '(("f.txt" "x") "d/"))
    (let ((fs (path-filesystem work)))
      (cond ((or (eq kind :memory) (local-mtimes-p))
             (ok (eq t (fs-set-mtime fs (path-pathname (join work "f.txt")) +old-time+)))
             (ok (= +old-time+ (file-stat-mtime (stat (join work "f.txt")))))
             (ok (= +old-time+ (last-modified (join work "f.txt"))))
             (ok (eq t (set-mtime (join work "f.txt") (+ +old-time+ 60))) "facade")
             (ok (= (+ +old-time+ 60) (last-modified (join work "f.txt")))))
            (t
             (ok (null (fs-set-mtime fs (path-pathname (join work "f.txt")) +old-time+))
                 "a no-op where mtimes cannot be set")))
      (ok (signals (set-mtime (join work "missing.txt") +old-time+) 'path-not-found)))))

(deftest set-mtime-zip
  (let ((zfs (make-zip-fs '(("a.txt" "a")))))
    (ok (null (fs-set-mtime zfs (fs-parse zfs "/a.txt") +old-time+)) "zip: a no-op")))

;;; --- areas built by clones ---------------------------------------------------------------

(deftest-parametrize area-clone-mechanisms
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (with-clone-fakes ()
      (let ((a (fresh-area work "auto")))
        (ok (eq :copy (area-mechanism a)) ":auto with nothing registered copies")
        (ok (clone-report-p (area-clone-report a)))
        (ok (eq :copy (clone-report-mechanism (area-clone-report a))))
        (ok (eq :no-mechanism (clone-report-reason (area-clone-report a))))
        (close-area a))
      (let ((a (fresh-area work "copy" :mechanism :copy)))
        (ok (eq :copy (area-mechanism a)))
        (ok (null (clone-report-reason (area-clone-report a))) ":copy asked for")
        (close-area a)))
    (with-clone-fakes (:fake-clone)
      (let ((a (fresh-area work "auto2")))
        (ok (eq :clone (area-mechanism a)) ":auto clones when it can")
        (ok (eq :fake-clone (clone-report-mechanism (area-clone-report a))))
        (ok (equal +area-copied-files+ (walk-files (area-root a))))
        (close-area a))
      (let ((a (fresh-area work "clone" :mechanism :clone)))
        (ok (eq :clone (area-mechanism a)))
        (close-area a))
      (let ((a (fresh-area work "named" :mechanism :fake-clone)))
        (ok (eq :clone (area-mechanism a)))
        (ok (eq :fake-clone (clone-report-mechanism (area-clone-report a))))
        (close-area a)))
    (with-clone-fakes (:fake-unsupported)
      (let ((a (fresh-area work "auto3")))
        (ok (eq :copy (area-mechanism a)))
        (ok (eq :unsupported-volume (clone-report-reason (area-clone-report a))))
        (close-area a)))))

(deftest-parametrize area-clone-refusals
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (area-tree base)
      (with-clone-fakes (:fake-unsupported :fake-clone)
        (dolist (mechanism '(:overlay :virtual :no-such-mechanism :fake-unsupported))
          (let ((dir (subdir work (format nil "area-~(~A~)" mechanism))))
            (ok (signals (open-area base :mechanism mechanism :directory dir) 'unsupported-operation)
                (format nil "~S refused" mechanism))
            (ok (not (exists-p dir)) "nothing is created"))))
      (with-clone-fakes (:fake-unsupported)
        (let ((dir (subdir work "area-clone")))
          (ok (signals (open-area base :mechanism :clone :directory dir) 'unsupported-operation)
              ":clone with no clone available")
          (ok (not (exists-p dir)) "nothing left on disk"))
        (let ((dir (subdir work "area-clone-empty")))
          (mkdir dir :parents t)
          (ok (signals (open-area base :mechanism :clone :directory dir) 'unsupported-operation))
          (ok (and (directory-p dir) (null (iterdir dir))) "a given empty directory stays empty"))))))

(deftest-parametrize area-clone-equals-copy
    ((kind) :ids ("local" "memory") (:local) (:memory))
  ;; The law in miniature, and a commit from a cloned area (law 6).
  (with-backend (work kind)
    (with-clone-fakes (:fake-clone)
      (multiple-value-bind (a base) (fresh-area work "c" :mechanism :clone)
        (let ((b (open-area base :ignore :auto :mechanism :copy :directory (subdir work "area-copy"))))
          (ok (equal (entry-summary (area-manifest a)) (entry-summary (area-manifest b))))
          (dolist (root (list (area-root a) (area-root b)))
            (external-write (join root "a.txt") "edited")
            (external-write (join root "new.txt") "new")
            (external-delete (join root "b.txt")))
          (ok (equal (change-details (area-changes a)) (change-details (area-changes b))))
          (ok (equal '((:modified "a.txt") (:removed "b.txt") (:added "new.txt"))
                     (change-summary (area-changes a))))
          (close-area b)
          (let ((expected (tree-id (area-root a))))
            (multiple-value-bind (changes status) (close-area a :action :commit)
              (ok (eq :committed status))
              (ok (= 3 (length changes))))
            (ok (equal expected (tree-id base :auto)) "projection = execution")))))))

(deftest area-copy-keeps-metadata
  ;; Areas are built with FS-CLONE-TREE: a :copy area now keeps all
  ;; permission bits and mtimes (R4a kept only the execute bit).
  (with-backend (work :local)
    (let ((base (subdir work "base")))
      (area-tree base)
      (when (unix-modes-p)
        (chmod (join base "a.txt") #o600))
      (when (local-mtimes-p)
        (set-mtime (join base "b.txt") +old-time+))
      (let ((a (open-area base :ignore :auto :mechanism :copy :directory (subdir work "area"))))
        (unwind-protect
             (progn
               (when (unix-modes-p)
                 (ok (= #o600 (logand #o777 (file-stat-mode (stat (join (area-root a) "a.txt")))))))
               (when (local-mtimes-p)
                 (ok (= +old-time+ (file-stat-mtime (stat (join (area-root a) "b.txt"))))))
               (ok (null (area-changes a)) "metadata kept is not a change")
               (external-write (join (area-root a) "b.txt") "bbb")
               (ok (null (area-changes a)) "same content, new mtime: still no change")
               (external-write (join (area-root a) "b.txt") "zzz")
               (ok (equal '((:modified "b.txt")) (change-summary (area-changes a)))
                   "an old preserved mtime is not racy: a same-size edit is found"))
          (close-area a))))))
