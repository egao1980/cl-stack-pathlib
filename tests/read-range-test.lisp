(in-package #:cl-stack-pathlib/tests)

;;; Ranged and streaming reads: FS-READ-RANGE (octets, half-open),
;;; FS-READ-LINES (1-based inclusive), FS-OPEN (input streams).

(defun iota-octets (n)
  (let ((v (make-array n :element-type '(unsigned-byte 8))))
    (dotimes (i n v) (setf (aref v i) (mod i 256)))))

(defun iota-list (start end)
  (loop for i from start below end collect (mod i 256)))

(deftest-parametrize read-range-octets
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (root kind)
    (let ((p (join root "data.bin")))
      (write-bytes p (iota-octets 100))
      (ok (equalp (read-range p 10 20) (coerce (iota-list 10 20) 'vector)))
      (ok (typep (read-range p 10 20) '(vector (unsigned-byte 8))))
      (ok (= 10 (length (read-range p 10 20))))
      (ok (equalp (read-range p 0 1) #(0)))
      (ok (equalp (read-range p 90 nil) (coerce (iota-list 90 100) 'vector)))
      (ok (equalp (read-range p 90) (coerce (iota-list 90 100) 'vector)))
      (ok (equalp (read-range p 95 1000) (coerce (iota-list 95 100) 'vector)) "END clamped")
      (ok (zerop (length (read-range p 100 nil))) "START = size")
      (ok (zerop (length (read-range p 500 600))) "START past size")
      (ok (zerop (length (read-range p 7 7))) "empty range")
      (ok (equalp (fs-read-range (path-filesystem p) (path-pathname p) 0 nil) (iota-octets 100)))
      (ok (signals (read-range p 5 2) 'error) "START > END")
      (ok (signals (read-range (join root "missing.bin") 0 1) 'path-not-found)))))

(deftest-parametrize read-lines-ranges
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (root kind)
    (let ((p (join root "lines.txt"))
          (cr (string #\Return))
          (lf (string #\Newline)))
      (write-text p (concatenate 'string "one" lf "two" cr lf "three" lf))
      (multiple-value-bind (lines more) (read-lines p)
        (ok (equal lines '("one" "two" "three")) "CR before LF removed")
        (ng more))
      (multiple-value-bind (lines more) (read-lines p :start 2 :end 2)
        (ok (equal lines '("two")))
        (ok more "line 3 follows"))
      (multiple-value-bind (lines more) (read-lines p :start 2 :end 3)
        (ok (equal lines '("two" "three")))
        (ng more))
      (multiple-value-bind (lines more) (read-lines p :start 3 :end 99)
        (ok (equal lines '("three")))
        (ng more))
      (multiple-value-bind (lines more) (read-lines p :start 4)
        (ok (null lines))
        (ng more))
      (multiple-value-bind (lines more) (read-lines p :end 1)
        (ok (equal lines '("one")))
        (ok more))
      (ok (equal (fs-read-lines (path-filesystem p) (path-pathname p) :start 1 :end 1) '("one")))
      ;; No final newline: the last line still counts.
      (write-text p (concatenate 'string "a" lf "b"))
      (ok (equal (read-lines p) '("a" "b")))
      ;; Blank lines are lines; a final LF adds none.
      (write-text p (concatenate 'string lf lf))
      (ok (equal (read-lines p) '("" "")))
      (write-text p "")
      (ok (null (read-lines p)))
      ;; UTF-8 decoding.
      (write-text p (format nil "h~Cllo~%~C~%" (code-char #xE9) (code-char #x2713)))
      (ok (equal (read-lines p) (list (format nil "h~Cllo" (code-char #xE9))
                                      (string (code-char #x2713)))))
      (ok (signals (read-lines (join root "missing.txt")) 'path-not-found)))))

(deftest-parametrize open-path-streams
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (root kind)
    (let ((p (join root "s.txt")))
      (write-text p (format nil "first~%second~%"))
      (with-open-path (in p)
        (ok (input-stream-p in))
        (ok (= (read-byte in) (char-code #\f)))
        (let ((buf (make-array 4 :element-type '(unsigned-byte 8))))
          (ok (= 4 (read-sequence buf in)))
          (ok (equalp buf (octets "irst"))))
        (ok (= (read-byte in) 10))
        (let ((rest (loop for b = (read-byte in nil nil) while b collect b)))
          (ok (equal rest (coerce (octets (format nil "second~%")) 'list))))
        (ok (null (read-byte in nil nil)) "EOF"))
      (with-open-path (in p :element-type 'character)
        (ok (string= (read-line in) "first"))
        (ok (string= (read-line in) "second"))
        (ok (null (read-line in nil nil))))
      (let ((s (fs-open (path-filesystem p) (path-pathname p))))
        (unwind-protect (ok (= (read-byte s) (char-code #\f)))
          (close s)))
      (ok (signals (open-path p :direction :output) 'unsupported-operation))
      (ok (signals (open-path (join root "missing")) 'path-not-found)))))

(deftest ranged-reads-zip
  (let ((fs (make-zip-fs (list (list "a.txt" (format nil "one~%two~%three~%"))))))
    (with-filesystem (fs)
      (ok (equalp (read-range "/a.txt" 4 7) (octets "two")))
      (multiple-value-bind (lines more) (read-lines "/a.txt" :start 2 :end 2)
        (ok (equal lines '("two")))
        (ok more))
      (with-open-path (in "/a.txt" :element-type 'character)
        (ok (string= (read-line in) "one"))))))
