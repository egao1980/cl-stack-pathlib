(in-package #:cl-stack-pathlib/tests)

;;; R4a snapshots: locked encoding and ids, stores, restore, changes.
;;; Parametrized over backend × store: the directory store lives on the same
;;; backend as the tree, beside it.

(deftest snapshot-manifest-encoding
  (let* ((entries (list (make-snapshot-entry "src/a.lisp" :file (h (format nil "(defun a () 1)~%")))
                        (make-snapshot-entry "README.md" :file (h (format nil "hello~%")))
                        (make-snapshot-entry "src/b/c.txt" :file (h ""))
                        (make-snapshot-entry (format nil "dir with space/~C.txt" (code-char #xE9))
                                             :file (h (format nil "~C~%" (code-char #xFC))))))
         (expected (octets (fixed-tree-manifest-string))))
    ;; The recorded id is the digest of the locked manifest text.
    (ok (string= +fixed-tree-id+ (octets-hash expected)))
    (ok (string= +empty-tree-id+ (h (format nil "cl-stack-pathlib tree v1~%"))))
    (ok (string= +fixed-exec-tree-id+ (octets-hash (octets (fixed-tree-manifest-string :exec t)))))
    ;; Encoding sorts by path, whatever the input order.
    (ok (equalp expected (snapshot-manifest-octets entries)))
    (ok (equalp expected (snapshot-manifest-octets (reverse entries))))
    (ok (equalp (octets (format nil "cl-stack-pathlib tree v1~%")) (snapshot-manifest-octets '())))
    (ok (equal (fixed-tree-entry-summary) (entry-summary (parse-snapshot-manifest expected))))
    ;; Modes.
    (let ((m (snapshot-manifest-octets
              (list (make-snapshot-entry "x" :executable (h "x"))
                    (make-snapshot-entry "l" :symlink (h "/t"))))))
      (ok (equalp m (octets (format nil "cl-stack-pathlib tree v1~%120000 ~A 1 l~%100755 ~A 1 x~%"
                                    (h "/t") (h "x")))))
      (ok (equal (list (list "l" :symlink (h "/t")) (list "x" :executable (h "x")))
                 (entry-summary (parse-snapshot-manifest m)))))
    ;; Duplicates and malformed manifests.
    (ok (signals (snapshot-manifest-octets (list (make-snapshot-entry "a" :file (h ""))
                                                 (make-snapshot-entry "a" :file (h "x"))))
                 'error))
    (ok (signals (parse-snapshot-manifest (octets "not a manifest")) 'snapshot-error))
    (ok (signals (parse-snapshot-manifest
                  (octets (format nil "cl-stack-pathlib tree v1~%100644 ~A 9 short~%" (h ""))))
                 'snapshot-error))))

(deftest-parametrize snapshot-store-blobs
    ((store-kind) :ids ("memory" "directory") (:memory) (:directory))
  (with-r4a (work store :local store-kind)
    (let* ((data (octets "blob content"))
           (id (snapshot-store-put store data)))
      (ok (string= id (octets-hash data)))
      (ok (string= id (snapshot-store-put store data)) "idempotent")
      (ok (snapshot-store-contains-p store id))
      (ok (equalp data (snapshot-store-get store id)))
      (ok (not (snapshot-store-contains-p store (h "absent"))))
      (ok (signals (snapshot-store-get store (h "absent")) 'snapshot-not-found))
      (handler-case (snapshot-store-get store (h "absent"))
        (snapshot-not-found (c)
          (ok (string= (h "absent") (snapshot-error-id c)))
          (ok (eq store (snapshot-error-store c)))))
      (when (eq store-kind :directory)
        (ok (equalp data (read-bytes (blob-file store id))) "locked layout blobs/sha256/xx/…")))))

(deftest-parametrize snapshot-id-fixed
    ((kind store-kind) :ids ("local/directory" "local/memory" "memory/memory" "memory/directory")
     (:local :directory) (:local :memory) (:memory :memory) (:memory :directory))
  (with-r4a (work store kind store-kind)
    (let ((root (subdir work "tree")))
      (make-tree root (fixed-tree-entries))
      (let ((id (snapshot root :store store)))
        (ok (string= +fixed-tree-id+ id))
        (ok (string= id (snapshot root :store store)) "same id on a second run")
        (ok (string= id (fs-snapshot (path-filesystem root) (path-pathname root) :store store)))
        (ok (equalp (octets (fixed-tree-manifest-string)) (snapshot-store-get store id))
            "the manifest is a blob whose digest is the id")
        (ok (equal (fixed-tree-entry-summary) (entry-summary (snapshot-entries id :store store))))
        (dolist (e (fixed-tree-entry-summary))
          (ok (snapshot-store-contains-p store (third e)) "every content blob is stored"))
        (ok (equal (walk-files root) (mapcar #'first (fixed-tree-entry-summary))) "ROOT untouched"))
      ;; Same content elsewhere, written in another order: same id.
      (let ((other (subdir work "elsewhere/deeper")))
        (make-tree other (reverse (fixed-tree-entries)))
        (ok (string= +fixed-tree-id+ (snapshot other :store store)))))))

(deftest-parametrize snapshot-empty-and-missing
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-r4a (work store kind :memory)
    (let ((root (subdir work "tree")))
      (make-tree root '("a/" "b/c/"))
      (ok (string= +empty-tree-id+ (snapshot root :store store)) "directories are not entries")
      (ok (signals (snapshot (subdir work "missing") :store store) 'path-not-found)))))

(deftest snapshot-executable-bit-local
  (if (not (unix-modes-p))
      (skip "file modes need SBCL / ECL on unix; Windows files are always :FILE")
      (with-r4a (work store :local :memory)
        (let ((root (subdir work "tree")))
          (make-tree root (cons (list "bin/run.sh" (run-sh-content)) (fixed-tree-entries)))
          (chmod (join root "bin/run.sh") #o755)
          (ok (string= +fixed-exec-tree-id+ (snapshot root :store store)))
          ;; Only the owner execute bit counts: other bits (umask) do not.
          (chmod (join root "bin/run.sh") #o700)
          (chmod (join root "README.md") #o600)
          (ok (string= +fixed-exec-tree-id+ (snapshot root :store store)))
          (chmod (join root "README.md") #o666)
          (ok (string= +fixed-exec-tree-id+ (snapshot root :store store)))
          (ok (eq :executable (snapshot-entry-mode
                               (find "bin/run.sh" (snapshot-entries (snapshot root :store store) :store store)
                                     :key #'snapshot-entry-path :test #'string=))))))))

(deftest-parametrize snapshot-honours-ignore
    ((kind store-kind) :ids ("local/directory" "memory/memory") (:local :directory) (:memory :memory))
  (with-r4a (work store kind store-kind)
    (let ((root (subdir work "tree"))
          (junk "ignored junk 7f3e"))
      (make-tree root (append (fixed-tree-entries)
                              `(("debug.log" ,junk) ("src/trace.log" ,junk)
                                ("build/out.o" ,junk) (".git/HEAD" ,junk))))
      (ok (string= +fixed-tree-id+
                   (snapshot root :store store :ignore (parse-ignore '(".git/" "*.log" "build/")))))
      (ok (not (snapshot-store-contains-p store (h junk))) "ignored content never enters the store")
      (ok (string/= +fixed-tree-id+ (snapshot root :store store)) "without IGNORE everything counts")
      ;; :AUTO reads .gitignore (an ordinary entry itself) and prunes .git/.
      (let ((root2 (subdir work "tree2")))
        (make-tree root2 `((".gitignore" ,(format nil "*.log~%build/~%"))
                           ("a.txt" "a") ("x.log" ,junk) ("build/o" ,junk) (".git/HEAD" ,junk)))
        (let ((id (snapshot root2 :store store :ignore :auto)))
          (ok (equal (list ".gitignore" "a.txt")
                     (mapcar #'snapshot-entry-path (snapshot-entries id :store store)))))))))

(deftest-parametrize snapshot-restore-round-trip
    ((kind store-kind) :ids ("local/directory" "local/memory" "memory/memory" "memory/directory")
     (:local :directory) (:local :memory) (:memory :memory) (:memory :directory))
  (with-r4a (work store kind store-kind)
    (let ((root (subdir work "tree")))
      (make-tree root (fixed-tree-entries))
      (let ((id (snapshot root :store store)))
        (ok (null (restore-snapshot root id :store store)) "restoring the current state changes nothing")
        ;; Mutate: modify, remove, add (in a new directory).
        (write-text (join root "README.md") "changed")
        (unlink (join root "src/a.lisp"))
        (make-tree root '(("new/deep/n.txt" "n") ("extra.txt" "e")))
        (let ((applied (restore-snapshot root id :store store)))
          (ok (equal '((:modified "README.md") (:removed "extra.txt")
                       (:removed "new/deep/n.txt") (:added "src/a.lisp"))
                     (change-summary applied))
              "the changes from the tree before the call to the snapshot, sorted by path"))
        (ok (string= id (snapshot root :store store)))
        (ok (equal (walk-files root) (mapcar #'first (fixed-tree-entry-summary))))
        (ok (string= (format nil "hello~%") (text-at root "README.md")))
        (ok (string= (format nil "(defun a () 1)~%") (text-at root "src/a.lisp")))
        (ok (not (exists-p (join root "new"))) "directories emptied by the restore are removed")
        (ok (exists-p root))
        ;; Into a directory that does not exist yet.
        (let ((fresh (subdir work "fresh/root")))
          (restore-snapshot fresh id :store store)
          (ok (string= id (snapshot fresh :store store)))
          (ok (string= (format nil "~C~%" (code-char #xFC))
                       (text-at fresh (format nil "dir with space/~C.txt" (code-char #xE9))))))
        ;; The protocol call.
        (write-text (join root "README.md") "again")
        (fs-restore (path-filesystem root) (path-pathname root) id :store store)
        (ok (string= id (snapshot root :store store)))))))

(deftest-parametrize snapshot-restore-ignore-and-unknown
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-r4a (work store kind :memory)
    (let ((root (subdir work "tree"))
          (ig (parse-ignore '("*.log" "build/"))))
      (make-tree root (fixed-tree-entries))
      (let ((id (snapshot root :store store :ignore ig)))
        (make-tree root '(("run.log" "log") ("build/o" "o") ("stray.txt" "s")))
        (restore-snapshot root id :store store :ignore ig)
        (ok (string= "log" (text-at root "run.log")) "ignored files are not deleted")
        (ok (string= "o" (text-at root "build/o")))
        (ok (not (exists-p (join root "stray.txt"))))
        (ok (string= id (snapshot root :store store :ignore ig)))
        ;; Unknown snapshot: signalled before anything is touched.
        (write-text (join root "README.md") "keep me")
        (ok (signals (restore-snapshot root (h "no such snapshot") :store store) 'snapshot-not-found))
        (ok (string= "keep me" (text-at root "README.md")))))))

(deftest snapshot-restore-executable-local
  (if (not (unix-modes-p))
      (skip "file modes need SBCL / ECL on unix")
      (with-r4a (work store :local :directory)
        (let ((root (subdir work "tree")))
          (make-tree root `(("run.sh" ,(run-sh-content)) ("plain.txt" "p")))
          (chmod (join root "run.sh") #o755)
          (let ((id (snapshot root :store store)))
            (chmod (join root "run.sh") #o644)
            (chmod (join root "plain.txt") #o755)
            (ok (equal '((:mode-changed "plain.txt") (:mode-changed "run.sh"))
                       (change-summary (restore-snapshot root id :store store))))
            (ok (executable-p (join root "run.sh")))
            (ok (not (executable-p (join root "plain.txt"))))
            (ok (string= id (snapshot root :store store))))))))

(deftest snapshot-directory-store-survives
  ;; A second store object over the same directory (a later run) sees the snapshot.
  (with-backend (work :local)
    (let* ((root (subdir work "tree"))
           (s1 (make-directory-snapshot-store (subdir work "store"))))
      (make-tree root (fixed-tree-entries))
      (let* ((id (snapshot root :store s1))
             (s2 (make-directory-snapshot-store (subdir work "store")))
             (target (subdir work "restored")))
        (ok (snapshot-store-contains-p s2 id))
        (restore-snapshot target id :store s2)
        (ok (string= +fixed-tree-id+ (snapshot target :store s2)))
        (ok (exists-p (blob-file s2 (h (format nil "hello~%")))))))))

(deftest-parametrize snapshot-changes-between
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-r4a (work store kind :memory)
    (let ((root (subdir work "tree")))
      (make-tree root '(("keep.txt" "k") ("mod.txt" "old") ("gone.txt" "g") ("d/x.txt" "x")))
      (let ((a (snapshot root :store store)))
        (write-text (join root "mod.txt") "new")
        (unlink (join root "gone.txt"))
        (make-tree root '(("added.txt" "+") ("d/y.txt" "y")))
        (let ((b (snapshot root :store store)))
          (ok (null (snapshot-changes a a :store store)) "diff(a, a) is empty")
          (ok (equal `((:added "added.txt" nil :file nil ,(h "+"))
                       (:added "d/y.txt" nil :file nil ,(h "y"))
                       (:removed "gone.txt" :file nil ,(h "g") nil)
                       (:modified "mod.txt" :file :file ,(h "old") ,(h "new")))
                     (change-details (snapshot-changes a b :store store))))
          (ok (equal '((:removed "added.txt") (:removed "d/y.txt") (:added "gone.txt") (:modified "mod.txt"))
                     (change-summary (snapshot-changes b a :store store))))
          (ok (equal (change-details (snapshot-changes a b :store store))
                     (change-details (fs-snapshot-changes store a b))))
          ;; NIL is the empty tree.
          (ok (equal '((:added "d/x.txt") (:added "gone.txt") (:added "keep.txt") (:added "mod.txt"))
                     (change-summary (snapshot-changes nil a :store store))))
          (ok (equal '((:removed "added.txt") (:removed "d/x.txt") (:removed "d/y.txt")
                       (:removed "keep.txt") (:removed "mod.txt"))
                     (change-summary (snapshot-changes b nil :store store))))
          (ok (signals (snapshot-changes a (h "unknown") :store store) 'snapshot-not-found)))))))

(deftest snapshot-changes-mode-local
  (if (not (unix-modes-p))
      (skip "file modes need SBCL / ECL on unix")
      (with-r4a (work store :local :memory)
        (let ((root (subdir work "tree")))
          (make-tree root '(("s.sh" "echo") ("t.sh" "echo")))
          (let ((a (snapshot root :store store)))
            (chmod (join root "s.sh") #o755)
            (chmod (join root "t.sh") #o755)
            (write-text (join root "t.sh") "echo 2")
            (let ((b (snapshot root :store store)))
              (ok (equal `((:mode-changed "s.sh" :file :executable ,(h "echo") ,(h "echo"))
                           (:modified "t.sh" :file :executable ,(h "echo") ,(h "echo 2")))
                         (change-details (snapshot-changes a b :store store))))))))))

(deftest-parametrize snapshot-symlinks
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (if (and (eq kind :local) (uiop:os-windows-p))
      (skip "local symlinks need unix")
      (with-r4a (work store kind :memory)
        (let* ((root (subdir work "tree"))
               (real (join root "real.txt"))
               (link (join root "link")))
          (make-tree root '(("real.txt" "data")))
          (create-symlink link real)
          (let* ((target (as-posix (read-symlink link)))
                 (id (snapshot root :store store)))
            (ok (equal `(("link" :symlink ,(h target)) ("real.txt" :file ,(h "data")))
                       (entry-summary (snapshot-entries id :store store)))
                "a symlink is an entry of its own, not followed")
            (unlink link)
            (restore-snapshot root id :store store)
            (ok (symlink-p link))
            (ok (string= target (as-posix (read-symlink link))))
            (ok (string= id (snapshot root :store store))))))))
