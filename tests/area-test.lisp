(in-package #:cl-stack-pathlib/tests)

;;; R4a areas: :copy mechanism, ignore, rescans that see edits made outside
;;; pathlib, discard / keep / commit, base-changed conflicts and restarts.

(deftest-parametrize area-copy-honours-ignore
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (multiple-value-bind (a base) (fresh-area work 1)
      (ok (area-p a))
      (ok (area-open-p a))
      (ok (eq :copy (area-mechanism a)))
      (ok (eq (path-filesystem base) (area-filesystem a)))
      (ok (same-directory-p base (area-base a)))
      (ok (same-directory-p (subdir work "area-1") (area-root a)))
      (ok (ignore-matcher-p (area-ignore a)) ":AUTO resolved at open")
      (ok (equal +area-copied-files+ (walk-files (area-root a))) "ignored paths are not copied")
      (ok (directory-p (join (area-root a) "empty")) "directories are copied")
      (ok (string= "aaa" (text-at (area-root a) "a.txt")))
      (ok (equal +area-copied-files+ (mapcar #'snapshot-entry-path (area-manifest a))))
      (ok (equal (list ".gitignore" :file (h (format nil "*.log~%build/~%")))
                 (first (entry-summary (area-manifest a)))))
      (ok (equal +area-tree-files+ (walk-files base)) "base untouched")
      (ok (null (area-changes a)) "no changes right after open")
      (close-area a))
    ;; An explicit matcher (relative to the base).
    (multiple-value-bind (a) (fresh-area work 2 :ignore (parse-ignore '("src/" "*.sh")))
      (ok (equal '(".git/HEAD" ".gitignore" "a.txt" "b.txt" "build/out.o" "x.log")
                 (walk-files (area-root a))))
      (close-area a))
    ;; No IGNORE: everything.
    (multiple-value-bind (a base) (fresh-area work 3 :ignore nil)
      (ok (equal (walk-files base) (walk-files (area-root a))))
      (close-area a))))

(deftest-parametrize area-changes-see-external-edits
    ((kind) :ids ("local" "memory") (:local) (:memory))
  ;; Local: CL:OPEN on the native file. Memory: the raw protocol call. Either
  ;; way the area API is bypassed; the rescan has to find the edits.
  (with-backend (work kind)
    (multiple-value-bind (a base) (fresh-area work 1)
      (let* ((r (area-root a))
             (st (make-memory-snapshot-store))
             (s-open (snapshot base :store st :ignore :auto)))
        (external-write (join r "a.txt") "zzz") ; same size, same second as the copy
        (external-write (join r "new/n.txt") "n")
        (external-delete (join r "b.txt"))
        (external-write (join r "y.log") "ignored in the area too")
        (external-write (join r "build/z.o") "ignored")
        (external-write (join base "src/c.lisp") "(base edit)") ; the base is not the area
        (ok (equal `((:modified "a.txt" :file :file ,(h "aaa") ,(h "zzz"))
                     (:removed "b.txt" :file nil ,(h "bbb") nil)
                     (:added "new/n.txt" nil :file nil ,(h "n")))
                   (change-details (area-changes a))))
        (ok (equal (change-details (area-changes a)) (change-details (fs-area-changes a)))
            "a second rescan gives the same result")
        ;; Area changes = snapshot changes from the base as copied to the area now.
        (let ((s-area (snapshot r :store st :ignore (area-ignore a))))
          (ok (equal (change-details (snapshot-changes s-open s-area :store st))
                     (change-details (area-changes a)))))
        ;; Edited back to the original content: no longer a change.
        (external-write (join r "a.txt") "aaa")
        (ok (equal '((:removed "b.txt") (:added "new/n.txt")) (change-summary (area-changes a))))
        (close-area a)))))

(deftest area-changes-see-shell-edits
  (if (not (unix-modes-p))
      (skip "needs /bin/sh and file modes (unix)")
      (with-backend (work :local)
        (let* ((a (fresh-area work 1))
               (r (area-root a)))
          (run-sh r "printf zzz > a.txt && chmod +x run.sh && rm b.txt && mkdir -p sub && printf s > sub/s.txt && printf x > q.log")
          (ok (equal `((:modified "a.txt" :file :file ,(h "aaa") ,(h "zzz"))
                       (:removed "b.txt" :file nil ,(h "bbb") nil)
                       (:mode-changed "run.sh" :file :executable ,(h "echo") ,(h "echo"))
                       (:added "sub/s.txt" nil :file nil ,(h "s")))
                     (change-details (area-changes a))))
          (close-area a)))))

(deftest-parametrize area-discard-and-keep
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    ;; :DISCARD (the default action) deletes the copy; the base is untouched.
    (multiple-value-bind (a base) (fresh-area work 1)
      (let ((r (area-root a)))
        (external-write (join r "a.txt") "edited")
        (ok (equal '(nil :discarded) (multiple-value-list (close-area a))))
        (ok (not (exists-p r)))
        (ok (not (area-open-p a)))
        (ok (string= "aaa" (text-at base "a.txt")))
        (ok (equal +area-tree-files+ (walk-files base)))
        (ok (signals (area-changes a) 'area-error) "a closed area refuses rescans")
        (ok (signals (close-area a) 'area-error) "and a second close")))
    ;; :KEEP leaves the copy with its edits.
    (multiple-value-bind (a base) (fresh-area work 2)
      (let ((r (area-root a)))
        (external-write (join r "a.txt") "edited")
        (ok (equal '(nil :kept) (multiple-value-list (close-area a :action :keep))))
        (ok (not (area-open-p a)))
        (ok (string= "edited" (text-at r "a.txt")))
        (ok (string= "aaa" (text-at base "a.txt")))))
    ;; WITH-AREA discards on exit.
    (let ((base (subdir work "base-3"))
          root)
      (area-tree base)
      (with-area (a base :directory (subdir work "area-3"))
        (setf root (area-root a))
        (ok (exists-p (join root "a.txt"))))
      (ok (not (exists-p root))))
    ;; No :DIRECTORY: a fresh temp directory outside the base.
    (let ((base (subdir work "base-4")))
      (area-tree base)
      (let* ((a (open-area base :ignore :auto))
             (r (area-root a)))
        (ok (directory-p r))
        (ok (not (under-p r base)))
        (ok (equal +area-copied-files+ (walk-files r)))
        (close-area a)
        (ok (not (exists-p r)))))))

(deftest-parametrize area-commit
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (multiple-value-bind (a base) (fresh-area work 1)
      (let ((r (area-root a)))
        (external-write (join r "a.txt") "zzz")
        (external-delete (join r "b.txt"))
        (external-write (join r "new/n.txt") "n")
        (external-write (join r "y.log") "ignored, never committed")
        (external-write (join base "src/c.lisp") "(base edit)") ; untouched by the area
        (multiple-value-bind (changes status) (close-area a :action :commit)
          (ok (eq :committed status))
          (ok (equal '((:modified "a.txt") (:removed "b.txt") (:added "new/n.txt"))
                     (change-summary changes))))
        (ok (not (area-open-p a)))
        (ok (not (exists-p r)) "the copy is deleted after a commit")
        (ok (string= "zzz" (text-at base "a.txt")))
        (ok (not (exists-p (join base "b.txt"))))
        (ok (string= "n" (text-at base "new/n.txt")))
        (ok (string= "(base edit)" (text-at base "src/c.lisp")) "paths the area did not change keep the base's version")
        (ok (not (exists-p (join base "y.log"))))
        (ok (equal '(".git/HEAD" ".gitignore" "a.txt" "build/out.o" "new/n.txt" "run.sh" "src/c.lisp" "x.log")
                   (walk-files base))
            "ignored base files survive")
        (ok (directory-p (join base "empty")))))
    ;; Law 6: with no base edits, the committed base equals the area.
    (multiple-value-bind (a base) (fresh-area work 2)
      (let ((r (area-root a))
            (st (make-memory-snapshot-store)))
        (external-write (join r "a.txt") "law six")
        (external-delete (join r "src/c.lisp"))
        (external-write (join r "d/e/f.txt") "f")
        (let ((s-area (snapshot r :store st :ignore (area-ignore a))))
          (close-area a :action :commit)
          (ok (string= s-area (snapshot base :store st :ignore :auto)))
          (ok (not (exists-p (join base "src"))) "directories emptied by removals are removed"))))
    ;; The protocol calls.
    (let ((base (subdir work "base-3"))
          (fs (path-filesystem work)))
      (area-tree base)
      (let ((a (fs-open-area fs (path-pathname base) :ignore :auto
                                                     :directory (path-pathname (subdir work "area-3")))))
        (external-write (join (area-root a) "a.txt") "p")
        (ok (equal '((:modified "a.txt")) (change-summary (fs-area-changes a))))
        (fs-close-area a :action :commit)
        (ok (string= "p" (text-at base "a.txt")))))))

(deftest area-commit-mode-local
  (if (not (unix-modes-p))
      (skip "file modes need SBCL / ECL on unix")
      (with-backend (work :local)
        (multiple-value-bind (a base) (fresh-area work 1)
          (chmod (join (area-root a) "run.sh") #o755)
          (ok (equal '((:mode-changed "run.sh")) (change-summary (area-changes a))))
          (close-area a :action :commit)
          (ok (executable-p (join base "run.sh")))))))

(defun conflict-area (work tag)
  "An area whose commit conflicts on a.txt (base \"base!\", area \"area\") and
adds n.txt without conflict. Returns (values area base)."
  (multiple-value-bind (a base) (fresh-area work tag)
    (external-write (join (area-root a) "a.txt") "area")
    (external-write (join (area-root a) "n.txt") "n")
    (external-write (join base "a.txt") "base!")
    (values a base)))

(deftest-parametrize area-commit-conflict-restarts
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    ;; SKIP-PATH: the base keeps its version; the other changes are written.
    (multiple-value-bind (a base) (conflict-area work 1)
      (let (names cpath carea open-e base-e area-e count changes status)
        (setf count 0)
        (ok (handler-bind ((area-conflict
                             (lambda (c)
                               (incf count)
                               (setf names (mapcar #'restart-name (compute-restarts c))
                                     cpath (area-conflict-path c)
                                     open-e (area-conflict-open-entry c)
                                     base-e (area-conflict-base-entry c)
                                     area-e (area-conflict-area-entry c))
                               (setf carea (area-error-area c))
                               (invoke-restart (find-restart 'skip-path c)))))
              (multiple-value-setq (changes status) (close-area a :action :commit))
              t))
        (ok (= 1 count) "one conflict, for a.txt")
        (ok (member 'overwrite names))
        (ok (member 'skip-path names))
        (ok (member 'abort-commit names))
        (ok (equal "a.txt" cpath))
        (ok (eq a carea))
        (ok (equal (h "aaa") (and open-e (snapshot-entry-hash open-e))))
        (ok (equal (h "base!") (and base-e (snapshot-entry-hash base-e))))
        (ok (equal (h "area") (and area-e (snapshot-entry-hash area-e))))
        (ok (eq :committed status))
        (ok (equal '((:added "n.txt")) (change-summary changes)) "skipped paths are not reported as written")
        (ok (string= "base!" (text-at base "a.txt")))
        (ok (string= "n" (text-at base "n.txt")))
        (ok (not (area-open-p a)))))
    ;; OVERWRITE: the area's version wins.
    (multiple-value-bind (a base) (conflict-area work 2)
      (ok (handler-bind ((area-conflict (lambda (c) (invoke-restart (find-restart 'overwrite c)))))
            (eq :committed (nth-value 1 (close-area a :action :commit)))))
      (ok (string= "area" (text-at base "a.txt")))
      (ok (string= "n" (text-at base "n.txt"))))
    ;; ABORT-COMMIT: nothing is written, the area stays open.
    (multiple-value-bind (a base) (conflict-area work 3)
      (ok (handler-bind ((area-conflict (lambda (c) (invoke-restart (find-restart 'abort-commit c)))))
            (equal '(nil :aborted) (multiple-value-list (close-area a :action :commit)))))
      (ok (string= "base!" (text-at base "a.txt")))
      (ok (not (exists-p (join base "n.txt"))) "non-conflicting changes are not written either")
      (ok (area-open-p a))
      (ok (string= "area" (text-at (area-root a) "a.txt")))
      (close-area a))
    ;; Helpers.
    (multiple-value-bind (a base) (conflict-area work 4)
      (ok (handler-bind ((area-conflict #'invoke-skip-path))
            (close-area a :action :commit)
            t))
      (ok (string= "base!" (text-at base "a.txt"))))
    (multiple-value-bind (a base) (conflict-area work 5)
      (ok (handler-bind ((area-conflict #'invoke-abort-commit))
            (eq :aborted (nth-value 1 (close-area a :action :commit)))))
      (ok (not (exists-p (join base "n.txt"))))
      (close-area a))
    ;; Unhandled: the error escapes before anything is written.
    (multiple-value-bind (a base) (conflict-area work 6)
      (ok (signals (close-area a :action :commit) 'area-conflict))
      (ok (string= "base!" (text-at base "a.txt")))
      (ok (not (exists-p (join base "n.txt"))))
      (ok (area-open-p a))
      (close-area a))))

(deftest-parametrize area-commit-conflict-cases
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (flet ((conflicts (a)
             "Paths that conflict on commit (each one skipped), sorted."
             (let ((paths '()))
               (handler-bind ((area-conflict (lambda (c)
                                               (push (area-conflict-path c) paths)
                                               (invoke-skip-path c))))
                 (close-area a :action :commit))
               (sort paths #'string<))))
      ;; The same edit on both sides, and a removal on both sides: no conflict.
      (multiple-value-bind (a base) (fresh-area work 1)
        (external-write (join (area-root a) "a.txt") "same")
        (external-write (join base "a.txt") "same")
        (external-delete (join (area-root a) "b.txt"))
        (external-delete (join base "b.txt"))
        (ok (null (conflicts a)))
        (ok (string= "same" (text-at base "a.txt"))))
      ;; Added on both sides with different content; removed in the area but
      ;; edited in the base; edited in the area but removed in the base.
      (multiple-value-bind (a base) (fresh-area work 2)
        (external-write (join (area-root a) "both.txt") "A")
        (external-write (join base "both.txt") "B")
        (external-delete (join (area-root a) "b.txt"))
        (external-write (join base "b.txt") "base edit")
        (external-write (join (area-root a) "run.sh") "echo area")
        (external-delete (join base "run.sh"))
        (let (seen)
          (handler-bind ((area-conflict (lambda (c)
                                          (push (list (area-conflict-path c)
                                                      (null (area-conflict-open-entry c))
                                                      (null (area-conflict-base-entry c))
                                                      (null (area-conflict-area-entry c)))
                                                seen)
                                          (invoke-skip-path c))))
            (close-area a :action :commit))
          (ok (equal '(("b.txt" nil nil t) ("both.txt" t nil nil) ("run.sh" nil t nil))
                     (sort seen #'string< :key #'first))))
        (ok (string= "B" (text-at base "both.txt")))
        (ok (string= "base edit" (text-at base "b.txt")))
        (ok (not (exists-p (join base "run.sh"))))))))

(deftest-parametrize area-open-errors
    ((kind) :ids ("local" "memory") (:local) (:memory))
  (with-backend (work kind)
    (let ((base (subdir work "base")))
      (area-tree base)
      (dolist (mechanism '(:clone :overlay :virtual :no-such-mechanism))
        (let ((dir (subdir work (format nil "area-~(~A~)" mechanism))))
          (ok (signals (open-area base :mechanism mechanism :directory dir) 'unsupported-operation)
              (format nil "~S is not portable" mechanism))
          (ok (not (exists-p dir)) "nothing is created")))
      (ok (signals (open-area (subdir work "missing") :directory (subdir work "area-m")) 'path-not-found))
      ;; DIRECTORY must be absent or empty.
      (let ((busy (subdir work "busy")))
        (make-tree busy '(("x" "x")))
        (ok (signals (open-area base :directory busy) 'path-exists-error))
        (ok (equal '("x") (walk-files busy))))
      (let ((empty (subdir work "empty-target")))
        (mkdir empty :parents t)
        (let ((a (open-area base :directory empty)))
          (ok (equal (walk-files base) (walk-files (area-root a))))
          (close-area a))))))

(deftest-parametrize make-temp-names-are-unique
    ((kind) :ids ("local" "memory") (:local) (:memory))
  ;; #25: names made within one second must not collide.
  (with-backend (root kind)
    (let* ((fs (path-filesystem root))
           (names (loop repeat 50
                        collect (namestring (fs-make-temp fs :directory (path-pathname root))))))
      (ok (= 50 (length (remove-duplicates names :test #'string=)))))
    (let ((dirs (loop repeat 20 collect (as-posix (make-temp-directory :directory root)))))
      (ok (= 20 (length (remove-duplicates dirs :test #'string=))))
      (ok (every #'directory-p dirs)))))
